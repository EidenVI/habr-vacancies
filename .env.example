# Habr Career base URL
BASE_URL=https://career.habr.com
# General vacancy listing
URL_TEMPLATE=https://career.habr.com/vacancies?page={page}&type=all
# Filtered vacancy listing for analytics
URL_ANALYTICS_TEMPLATE=https://career.habr.com/vacancies?page={page}&s[]=98&s[]=41&s[]=42&s[]=43&s[]=168&s[]=99&s[]=208&s[]=76&s[]=96&s[]=97&s[]=95&s[]=100&s[]=133&s[]=111&type=all
# Individual vacancy page
VACANCY_URL_TEMPLATE=https://career.habr.com/vacancies/{vacancy_id}
# Maximum number of listing pages to collect
MAX_PAGES=1
# Output dataset
OUTPUT_CSV_PATH=data/processed/vacancies.csv
# SQLite database
DATABASE_PATH=data/vacancies.db